# Authentication: "oidc" for Keycloak sign-in, "mock" for local development without Keycloak.
# Mock mode only works in `npm run dev`; production builds ignore it.
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=http://localhost:8280/realms/insure-ai
VITE_OIDC_CLIENT_ID=insure-ui

# Leave empty to call the services through the dev proxy (see vite.config.ts).
VITE_CUSTOMER_API=
VITE_QUOTE_API=

# Dev proxy targets.
VITE_CUSTOMER_PROXY=http://localhost:8282
VITE_QUOTE_PROXY=http://localhost:8281
