# PostgreSQL server (one server, one database and one role per service)
INSURE_DB_HOST_PORT=5433
INSURE_DB_ADMIN_PASSWORD=replace-with-a-different-strong-local-password

# Quote Service database
INSURE_DB_URL=jdbc:postgresql://localhost:5433/insure_db
INSURE_DB_USERNAME=insure_app
INSURE_DB_PASSWORD=replace-with-a-strong-local-password

# Customer Service database
CUSTOMER_DB_URL=jdbc:postgresql://localhost:5433/customer_db
CUSTOMER_DB_USERNAME=customer_app
CUSTOMER_DB_PASSWORD=replace-with-a-strong-customer-database-password

# Keycloak
KEYCLOAK_PORT=8280
KEYCLOAK_PUBLIC_URL=http://localhost:8280
KEYCLOAK_ISSUER_URI=http://localhost:8280/realms/insure-ai
KEYCLOAK_TOKEN_URI=http://localhost:8280/realms/insure-ai/protocol/openid-connect/token
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-local-keycloak-admin-password
KEYCLOAK_QUOTE_CLIENT_ID=quote-service
KEYCLOAK_QUOTE_CLIENT_SECRET=replace-with-the-quote-service-client-secret

# JWT audiences
QUOTE_JWT_AUDIENCE=quote-service
CUSTOMER_JWT_AUDIENCE=customer-service

# Quote Service server
QUOTE_SERVICE_PORT=8281
QUOTE_SERVICE_ADDRESS=127.0.0.1

# Customer Service server
CUSTOMER_SERVICE_PORT=8282
CUSTOMER_SERVICE_ADDRESS=127.0.0.1

# Quote Service -> Customer Service client
CUSTOMER_SERVICE_BASE_URL=http://localhost:8282
CUSTOMER_SERVICE_CONNECT_TIMEOUT=1s
CUSTOMER_SERVICE_READ_TIMEOUT=2s

# API documentation (Swagger UI at /swagger-ui.html, spec at /v3/api-docs); keep false outside local development
API_DOCS_ENABLED=true
